# Local development PostgreSQL (port 5433 with unix socket on linux)
# Example: postgresql://hemant@localhost:5433/paperspace?host=/tmp
DATABASE_URL="postgresql://hemant@localhost:5433/paperspace?host=/tmp"
DIRECT_URL="postgresql://hemant@localhost:5433/paperspace?host=/tmp"

# Supabase Production PostgreSQL (for Vercel deployment)
# DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
